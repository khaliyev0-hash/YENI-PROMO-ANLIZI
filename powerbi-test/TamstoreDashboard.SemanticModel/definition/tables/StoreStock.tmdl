table StoreStock
	lineageTag: c1111111-1111-1111-1111-111111111111

	column STORE
		dataType: string
		lineageTag: c1111111-1111-1111-1111-111111111112
		summarizeBy: none
		sourceColumn: STORE

	column CODE
		dataType: string
		lineageTag: c1111111-1111-1111-1111-111111111113
		summarizeBy: none
		sourceColumn: CODE

	column STOCK_QTY
		dataType: double
		formatString: #,0.00
		lineageTag: c1111111-1111-1111-1111-111111111114
		summarizeBy: sum
		sourceColumn: STOCK_QTY

	partition StoreStock = m
		mode: import
		source =
				let
				    SqlQuery = "SELECT CAST([IS YERI NO] AS VARCHAR(50)) AS STORE, LTRIM(RTRIM(CAST([URUN KODU] AS VARCHAR(50)))) AS CODE, SUM(ISNULL([Stok miqdari], 0)) AS STOCK_QTY FROM vw_TS_ITEMS_DETAIL_MAGAZA_FOR_PLANNING GROUP BY [IS YERI NO], [URUN KODU]",
				    Source = Sql.Database(ServerName, DatabaseName, [Query=SqlQuery])
				in
				    Source

