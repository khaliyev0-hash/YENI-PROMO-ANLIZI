table StoreMaster
	lineageTag: e1111111-1111-1111-1111-111111111111

	column STORE
		dataType: string
		lineageTag: e1111111-1111-1111-1111-111111111112
		summarizeBy: none
		sourceColumn: STORE

	partition StoreMaster = m
		mode: import
		source =
				let
				    SqlQuery = "SELECT DISTINCT CAST([IS YERI NO] AS VARCHAR(50)) AS STORE FROM vw_TS_ITEMS_DETAIL_MAGAZA_FOR_PLANNING WHERE [IS YERI NO] IS NOT NULL",
				    Source = Sql.Database(ServerName, DatabaseName, [Query=SqlQuery])
				in
				    Source

